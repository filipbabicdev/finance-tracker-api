# Server
SERVER_PORT=8090

# Database (PostgreSQL)
# Use 'db' as host when running via docker compose, 'localhost' for local binary
DATABASE_URL=postgres://finance_user:CHANGE_ME@db:5432/finance_tracker?sslmode=disable

# Environment (development, production)
ENV=development

# Connection pool (optional, defaults applied if omitted)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MIN=5